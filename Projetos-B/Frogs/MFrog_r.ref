REFINEMENT MFrog_r
REFINES MFrog

VARIABLES
    state

INITIALISATION
    state := {b1 |-> 1, b2 |-> 2, b3 |-> 3,
              r1 |-> 5, r2 |-> 6, r3 |-> 7}

OPERATIONS
    move(frog,pos) =
    PRE
        frog : FROG
        & pos : STONE
        & (frog : BLUE => pos : {state(frog)+1, state(frog)+2})
        & (frog : RED => pos : {state(frog)-1, state(frog)-2})
        & pos /: ran(state)
    THEN
        state := state <+ {frog |-> pos}
    END

 END